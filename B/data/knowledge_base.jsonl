{"plant_id": "P01", "fields": {"学名与科属": {"content": "Monstera deliciosa（天南星科）", "source_url": "http://en.wikipedia.org/wiki/Monstera_deliciosa", "source_status": "verified"}, "形态特征": {"content": "大型常绿攀援藤本，叶心状卵形、深裂并具孔洞，成年叶径 40–60cm，茎节生气生根。", "source_url": "http://en.wikipedia.org/wiki/Monstera_deliciosa", "source_status": "verified"}, "光照需求": {"content": "1500-3500 lux；光照等级 L2", "source_url": "http://en.wikipedia.org/wiki/Monstera_deliciosa", "source_status": "verified"}, "浇水频率": {"content": "7-10 天/次（表土干后浇透）", "source_url": "http://en.wikipedia.org/wiki/Monstera_deliciosa", "source_status": "verified"}, "土壤配比": {"content": "泥炭:珍珠岩:松树皮=5:3:2", "source_url": "http://en.wikipedia.org/wiki/Monstera_deliciosa", "source_status": "verified"}, "适温范围": {"content": "18-28℃", "source_url": "http://en.wikipedia.org/wiki/Monstera_deliciosa", "source_status": "verified"}, "原产地": {"content": "墨西哥至中美洲", "source_url": "http://en.wikipedia.org/wiki/Monstera_deliciosa", "source_status": "verified"}, "毒性": {"content": "含草酸钙针晶，猫狗误食口腔灼痛、流涎", "source_url": "http://en.wikipedia.org/wiki/Monstera_deliciosa", "source_status": "verified"}}, "name_cn": "龟背竹"}
{"plant_id": "P02", "fields": {"学名与科属": {"content": "Ficus lyrata（桑科）", "source_url": "http://en.wikipedia.org/wiki/Ficus_lyrata", "source_status": "verified"}, "形态特征": {"content": "常绿乔木，叶大而厚、先端宽阔呈提琴状，叶脉明显，主干直立少分枝。", "source_url": "http://en.wikipedia.org/wiki/Ficus_lyrata", "source_status": "verified"}, "光照需求": {"content": "3500-8000 lux；光照等级 L3", "source_url": "http://en.wikipedia.org/wiki/Ficus_lyrata", "source_status": "verified"}, "浇水频率": {"content": "7-10 天/次（表土干后浇透）", "source_url": "http://en.wikipedia.org/wiki/Ficus_lyrata", "source_status": "verified"}, "土壤配比": {"content": "泥炭:珍珠岩:松树皮=5:3:2", "source_url": "http://en.wikipedia.org/wiki/Ficus_lyrata", "source_status": "verified"}, "适温范围": {"content": "18-27℃", "source_url": "http://en.wikipedia.org/wiki/Ficus_lyrata", "source_status": "verified"}, "原产地": {"content": "西非热带", "source_url": "http://en.wikipedia.org/wiki/Ficus_lyrata", "source_status": "verified"}, "毒性": {"content": "乳汁刺激皮肤与口腔黏膜", "source_url": "http://en.wikipedia.org/wiki/Ficus_lyrata", "source_status": "verified"}}, "name_cn": "琴叶榕"}
{"plant_id": "P03", "fields": {"学名与科属": {"content": "Ficus elastica（桑科）", "source_url": "http://en.wikipedia.org/wiki/Ficus_elastica", "source_status": "verified"}, "形态特征": {"content": "常绿乔木，叶椭圆形、厚革质有光泽，新叶红色、包被于托叶内。", "source_url": "http://en.wikipedia.org/wiki/Ficus_elastica", "source_status": "verified"}, "光照需求": {"content": "1500-3500 lux；光照等级 L2", "source_url": "http://en.wikipedia.org/wiki/Ficus_elastica", "source_status": "verified"}, "浇水频率": {"content": "10-14 天/次（表土干后浇透）", "source_url": "http://en.wikipedia.org/wiki/Ficus_elastica", "source_status": "verified"}, "土壤配比": {"content": "泥炭:珍珠岩:松树皮=5:3:2", "source_url": "http://en.wikipedia.org/wiki/Ficus_elastica", "source_status": "verified"}, "适温范围": {"content": "18-28℃", "source_url": "http://en.wikipedia.org/wiki/Ficus_elastica", "source_status": "verified"}, "原产地": {"content": "南亚至东南亚", "source_url": "http://en.wikipedia.org/wiki/Ficus_elastica", "source_status": "verified"}, "毒性": {"content": "乳汁刺激皮肤与口腔", "source_url": "http://en.wikipedia.org/wiki/Ficus_elastica", "source_status": "verified"}}, "name_cn": "橡皮树"}
