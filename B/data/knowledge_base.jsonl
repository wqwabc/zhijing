{"plant_id": "P32", "fields": {"学名与科属": {"content": "Tillandsia ionantha（凤梨科）", "source_url": "http://en.wikipedia.org/wiki/Tillandsia_ionantha", "source_status": "verified"}, "形态特征": {"content": "附生凤梨，无土栽培，叶小而密、被银白鳞片，开花时中心变红。", "source_url": "http://en.wikipedia.org/wiki/Tillandsia_ionantha", "source_status": "verified"}, "光照需求": {"content": "3500-8000 lux；光照等级 L3", "source_url": "http://en.wikipedia.org/wiki/Tillandsia_ionantha", "source_status": "verified"}, "浇水频率": {"content": "7 天/次（表土干后浇透）", "source_url": "http://en.wikipedia.org/wiki/Tillandsia_ionantha", "source_status": "verified"}, "土壤配比": {"content": "板植或树皮块固定，无需土壤", "source_url": "http://en.wikipedia.org/wiki/Tillandsia_ionantha", "source_status": "verified"}, "适温范围": {"content": "15-30℃", "source_url": "http://en.wikipedia.org/wiki/Tillandsia_ionantha", "source_status": "verified"}, "原产地": {"content": "墨西哥至中美洲", "source_url": "http://en.wikipedia.org/wiki/Tillandsia_ionantha", "source_status": "verified"}, "毒性": {"content": "无毒（ASPCA 收录）", "source_url": "http://en.wikipedia.org/wiki/Tillandsia_ionantha", "source_status": "verified"}}, "name_cn": "空气凤梨"}
{"plant_id": "P33", "fields": {"学名与科属": {"content": "Platycerium bifurcatum（水龙骨科）", "source_url": "http://en.wikipedia.org/wiki/Platycerium_bifurcatum", "source_status": "verified"}, "形态特征": {"content": "附生蕨类，基生叶呈盾状包覆，孢子叶分叉如鹿角，覆白绒毛。", "source_url": "http://en.wikipedia.org/wiki/Platycerium_bifurcatum", "source_status": "verified"}, "光照需求": {"content": "1500-3500 lux；光照等级 L2", "source_url": "http://en.wikipedia.org/wiki/Platycerium_bifurcatum", "source_status": "verified"}, "浇水频率": {"content": "5-7 天/次（表土干后浇透）", "source_url": "http://en.wikipedia.org/wiki/Platycerium_bifurcatum", "source_status": "verified"}, "土壤配比": {"content": "板植或树皮块固定，无需土壤", "source_url": "http://en.wikipedia.org/wiki/Platycerium_bifurcatum", "source_status": "verified"}, "适温范围": {"content": "18-28℃", "source_url": "http://en.wikipedia.org/wiki/Platycerium_bifurcatum", "source_status": "verified"}, "原产地": {"content": "澳洲至新几内亚", "source_url": "http://en.wikipedia.org/wiki/Platycerium_bifurcatum", "source_status": "verified"}, "毒性": {"content": "无毒（ASPCA 收录）", "source_url": "http://en.wikipedia.org/wiki/Platycerium_bifurcatum", "source_status": "verified"}}, "name_cn": "鹿角蕨"}
