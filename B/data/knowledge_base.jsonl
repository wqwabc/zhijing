{"plant_id": "P28", "fields": {"学名与科属": {"content": "Gardenia jasminoides（茜草科）", "source_url": "http://en.wikipedia.org/wiki/Gardenia_jasminoides", "source_status": "verified"}, "形态特征": {"content": "常绿灌木，叶椭圆、亮绿对生，花白色重瓣、香浓。", "source_url": "http://en.wikipedia.org/wiki/Gardenia_jasminoides", "source_status": "verified"}, "光照需求": {"content": "3500-8000 lux；光照等级 L3", "source_url": "http://en.wikipedia.org/wiki/Gardenia_jasminoides", "source_status": "verified"}, "浇水频率": {"content": "4-6 天/次（表土干后浇透）", "source_url": "http://en.wikipedia.org/wiki/Gardenia_jasminoides", "source_status": "verified"}, "土壤配比": {"content": "泥炭:松针土:珍珠岩=5:3:2（pH 5.5–6.5）", "source_url": "http://en.wikipedia.org/wiki/Gardenia_jasminoides", "source_status": "verified"}, "适温范围": {"content": "18-28℃", "source_url": "http://en.wikipedia.org/wiki/Gardenia_jasminoides", "source_status": "verified"}, "原产地": {"content": "中国至日本", "source_url": "http://en.wikipedia.org/wiki/Gardenia_jasminoides", "source_status": "verified"}, "毒性": {"content": "无毒（ASPCA 收录）", "source_url": "http://en.wikipedia.org/wiki/Gardenia_jasminoides", "source_status": "verified"}}, "name_cn": "栀子"}
{"plant_id": "P29", "fields": {"学名与科属": {"content": "Hydrangea macrophylla（绣球科）", "source_url": "http://en.wikipedia.org/wiki/Hydrangea_macrophylla", "source_status": "verified"}, "形态特征": {"content": "落叶灌木，叶大而对生，花序球形由不孕花组成，花色随 pH 变化。", "source_url": "http://en.wikipedia.org/wiki/Hydrangea_macrophylla", "source_status": "verified"}, "光照需求": {"content": "3500-8000 lux；光照等级 L3", "source_url": "http://en.wikipedia.org/wiki/Hydrangea_macrophylla", "source_status": "verified"}, "浇水频率": {"content": "3-5 天/次（表土干后浇透）", "source_url": "http://en.wikipedia.org/wiki/Hydrangea_macrophylla", "source_status": "verified"}, "土壤配比": {"content": "泥炭:珍珠岩:松树皮=5:3:2", "source_url": "http://en.wikipedia.org/wiki/Hydrangea_macrophylla", "source_status": "verified"}, "适温范围": {"content": "15-25℃", "source_url": "http://en.wikipedia.org/wiki/Hydrangea_macrophylla", "source_status": "verified"}, "原产地": {"content": "日本至中国", "source_url": "http://en.wikipedia.org/wiki/Hydrangea_macrophylla", "source_status": "verified"}, "毒性": {"content": "含氰苷，猫狗误食呕吐、腹泻", "source_url": "http://en.wikipedia.org/wiki/Hydrangea_macrophylla", "source_status": "verified"}}, "name_cn": "绣球"}
{"plant_id": "P30", "fields": {"学名与科属": {"content": "Salvia rosmarinus（唇形科）", "source_url": "https://en.wikipedia.org/wiki/Rosemary", "source_status": "verified"}, "形态特征": {"content": "常绿小灌木，叶线形革质、背面灰白，全株具浓郁香气。", "source_url": "https://en.wikipedia.org/wiki/Rosemary", "source_status": "verified"}, "光照需求": {"content": "8000-20000 lux；光照等级 L4", "source_url": "https://en.wikipedia.org/wiki/Rosemary", "source_status": "verified"}, "浇水频率": {"content": "10-14 天/次（表土干后浇透）", "source_url": "https://en.wikipedia.org/wiki/Rosemary", "source_status": "verified"}, "土壤配比": {"content": "颗粒土:泥炭=6:4", "source_url": "https://en.wikipedia.org/wiki/Rosemary", "source_status": "verified"}, "适温范围": {"content": "15-28℃", "source_url": "https://en.wikipedia.org/wiki/Rosemary", "source_status": "verified"}, "原产地": {"content": "地中海", "source_url": "https://en.wikipedia.org/wiki/Rosemary", "source_status": "verified"}, "毒性": {"content": "无毒（ASPCA 收录）", "source_url": "https://en.wikipedia.org/wiki/Rosemary", "source_status": "verified"}}, "name_cn": "迷迭香"}
