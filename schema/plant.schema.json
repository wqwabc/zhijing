{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verda.plant",
  "description": "植物主数据（plants_master.csv 的 JSON 形态，供 C/D 直接消费）",
  "type": "object",
  "required": ["plant_id", "name_cn", "name_latin", "form", "light_level", "toxic", "pet_safe"],
  "additionalProperties": false,
  "properties": {
    "plant_id": {"type": "string", "pattern": "^P\\d{2}$"},
    "name_cn": {"type": "string", "minLength": 1},
    "name_latin": {"type": "string", "minLength": 3},
    "family_cn": {"type": "string"},
    "form": {"enum": ["直立", "丛生", "垂吊", "攀援", "莲座", "树形", "剑叶", "附生"]},
    "leaf": {"type": "string"},
    "height_min_cm": {"type": "integer", "minimum": 5, "maximum": 400},
    "height_max_cm": {"type": "integer", "minimum": 5, "maximum": 400},
    "spread_cm": {"type": "integer", "minimum": 5, "maximum": 300},
    "light_level": {"enum": ["L1", "L2", "L3", "L4"]},
    "light_lux": {"type": "string"},
    "water_days": {"type": "string"},
    "temp_range": {"type": "string"},
    "soil_mix": {"type": "string"},
    "difficulty": {"enum": ["易", "中", "难"]},
    "toxic": {"enum": ["safe", "toxic", "unknown"]},
    "toxic_note": {"type": "string"},
    "pet_safe": {"type": "boolean"},
    "style_tags": {"type": "array", "items": {"enum": ["nordic", "wabi", "midcentury", "minimal", "tropical", "industrial"]}, "minItems": 1},
    "scene_tags": {"type": "array", "items": {"enum": ["bedroom", "study", "living", "balcony", "desk"]}, "minItems": 1},
    "price_cny": {"type": "string"},
    "care_min_week": {"type": "integer", "minimum": 0},
    "priority": {"enum": ["P0", "P1"]},
    "source_title": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "source_status": {"enum": ["verified", "pending"]}
  }
}
