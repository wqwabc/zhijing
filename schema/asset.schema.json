{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verda.asset",
  "description": "去底素材登记（assets_manifest.csv 一行对应一个对象）",
  "type": "object",
  "required": ["asset_id", "plant_id", "view", "status"],
  "additionalProperties": false,
  "properties": {
    "asset_id": {"type": "string", "pattern": "^A-P\\d{2}$"},
    "plant_id": {"type": "string", "pattern": "^P\\d{2}$"},
    "name_cn": {"type": "string"},
    "view": {"enum": ["front", "side45", "top"]},
    "status": {"enum": ["pending", "ready", "rejected"]},
    "file_path": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "author": {"type": ["string", "null"]},
    "license": {"type": ["string", "null"]},
    "license_url": {"type": ["string", "null"]},
    "width": {"type": ["integer", "null"]},
    "height": {"type": ["integer", "null"]},
    "has_alpha": {"enum": ["yes", "no"]},
    "dominant_hex": {"type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$"},
    "cutout_engine": {"enum": ["rembg", "simple", "manual", ""]},
    "height_cm": {"type": "string"},
    "collected_at": {"type": "string"},
    "note": {"type": "string"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "ready"}}},
    "then": {"required": ["file_path", "width", "height", "has_alpha", "source_url", "license"]}
  }]
}
